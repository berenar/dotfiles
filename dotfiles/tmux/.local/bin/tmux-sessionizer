#!/usr/bin/env bash

find_repos() {
  find ~/Development ~/mvst/repos ~/dotfiles -mindepth 1 -maxdepth 3 -name .git -prune -print 2>/dev/null | sed 's|/\.git$||'
}

add_session_names() {
  awk -v OFS='\t' '{ n = split($0, parts, "/"); name = parts[n - 1] "/" parts[n]; gsub(/\./, "_", name); print name, $0 }'
}

if [[ $1 == --list ]]; then
  find_repos | add_session_names
  exit 0
fi

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find_repos | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(add_session_names <<<"$selected" | cut -f1)
tmux_running=$(pgrep tmux)

setup_windows() {
  local session=$1
  local dir=$2
  local claude_cmd="claude-mvst"
  if [[ $dir == *clbrt* ]]; then
    claude_cmd="claude-clbrt"
  fi
  tmux rename-window -t "$session:1" git
  tmux send-keys -t "$session:1" "lazygit" Enter
  tmux new-window -t "$session" -c "$dir" -n nvim
  tmux send-keys -t "$session:2" "nvim" Enter
  tmux new-window -t "$session" -c "$dir" -n bash
  tmux new-window -t "$session" -c "$dir" -n claude
  tmux send-keys -t "$session:4" "$claude_cmd" Enter
  tmux select-window -t "$session:2"
}

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -ds "$selected_name" -c "$selected"
  setup_windows "$selected_name" "$selected"
  tmux attach -t "$selected_name"
  exit 0
fi

if ! tmux has-session -t "$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
  setup_windows "$selected_name" "$selected"
fi

if [[ -z $TMUX ]]; then
  tmux attach -t "$selected_name"
else
  tmux switch-client -t "$selected_name"
fi
