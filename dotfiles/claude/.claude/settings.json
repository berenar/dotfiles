{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {},
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "plugin:celebrate-agentic-tools:context7"
    },
    {
      "serverName": "plugin:celebrate-agentic-tools:linear"
    }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/open-markdown-preview.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reset-tmux-window.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/set-claude-running.sh off",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/caffeinate-while-thinking.sh off",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/set-claude-running.sh on",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/caffeinate-while-thinking.sh on",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rename-tmux-window.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/set-claude-running.sh off",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/caffeinate-while-thinking.sh off",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/flag-tmux-window.sh",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/play-sound-if-unfocused.sh /System/Library/Sounds/Funk.aiff"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/set-claude-running.sh off",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/caffeinate-while-thinking.sh off",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/flag-tmux-window.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "amplitude@claude-plugins-official": true,
    "celebrate-agentic-tools@celebrate-engineering": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "celebrate-engineering": {
      "source": {
        "source": "github",
        "repo": "kartenmacherei/agent-builder-v2"
      }
    },
    "mvst": {
      "source": {
        "source": "github",
        "repo": "mvstgmbh/mvst-agentic"
      }
    }
  },
  "outputStyle": "ASD-STE100",
  "spinnerTipsEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  }
}
